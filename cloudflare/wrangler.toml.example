name = "qrstack-api"
main = "cloudflare/src/worker.js"
compatibility_date = "2026-08-04"
workers_dev = true

[vars]
OWNER_ACCESS_TOKEN = "troque-por-sua-chave-da-central"
SHEETS_FALLBACK_URL = "https://script.google.com/macros/s/SEU_DEPLOY_DO_APPS_SCRIPT/exec"

[triggers]
crons = ["*/10 * * * *"]

[[kv_namespaces]]
binding = "INSIGHTS_CACHE"
id = "cole-o-namespace-id-do-kv-aqui"

[[d1_databases]]
binding = "DB"
database_name = "qrstack-db"
database_id = "cole-o-database-id-do-d1-aqui"
migrations_dir = "cloudflare/migrations"

[[queues.producers]]
binding = "ANALYTICS_RETRY_QUEUE"
queue = "qrstack-analytics-retry"

[[queues.consumers]]
queue = "qrstack-analytics-retry"
max_batch_size = 25
max_batch_timeout = 30
max_retries = 5
retry_delay = 900
dead_letter_queue = "qrstack-analytics-retry-dlq"
